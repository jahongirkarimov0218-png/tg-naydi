# TG Naydi Environment Variables (copy to .env.local for local dev; NEVER commit .env*)

# Provider mode: SANDBOX (default, zero-ban demo/CI) or LIVE_MTPROTO (requires external worker/mtproto.ts)
PROVIDER_MODE=SANDBOX
NEXT_PUBLIC_PROVIDER_MODE=SANDBOX

# Durable JobStore for Vercel (Upstash Redis Free tier — required when VERCEL=1)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Operator gate (REQUIRED when PROVIDER_MODE=LIVE_MTPROTO to protect the Telegram account)
OPERATOR_ACCESS_KEY=

# Standalone MTProto Worker ONLY (run worker/mtproto.ts outside Vercel; NEVER expose publicly)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Optional monitoring target URL for scripts/monitoring/anomaly_detector.mjs
PRODUCTION_HEALTH_URL=
