{
  "name": "tg-naydi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "eval:domain": "vitest run evals/domain-eval.test.ts",
    "eval:claude-ab": "node scripts/evals/run_claude_ab.mjs",
    "test:e2e": "playwright test",
    "worker:mtproto": "tsx worker/mtproto.ts",
    "worker:session": "node scripts/worker/generate_session.mjs",
    "quality:coverage": "vitest run tests/unit tests/integration --coverage",
    "quality:crap": "pnpm run quality:coverage && node scripts/quality/crap_report.mjs",
    "quality:dry": "jscpd src worker --min-tokens 35 --reporters console",
    "quality:knip": "knip",
    "quality:mutate": "stryker run",
    "smoke:prod": "node scripts/smoke/prod_smoke.mjs",
    "smoke:live-canary": "node scripts/smoke/live_canary.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "big-integer": "^1.6.52",
    "libphonenumber-js": "^1.12.0",
    "lucide-react": "^0.475.0",
    "next": "^15.5.0",
    "papaparse": "^5.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "telegram": "^2.26.22",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.51.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.13.10",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.5.0",
    "jscpd": "^5.4.3",
    "knip": "^6.46.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
